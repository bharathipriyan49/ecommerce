MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
PORT=5000

# SMS provider: local, twilio, or smslocal
SMS_PROVIDER=local

# SMSLocal provider settings
SMSLOCAL_API_KEY=
SMSLOCAL_USERNAME=
SMSLOCAL_PASSWORD=
SMSLOCAL_SENDER=MyShop
SMSLOCAL_ENDPOINT=https://api.smslocal.com/send

# Twilio provider settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram chat ID for the admin account or group receiving order notifications
TELEGRAM_ADMIN_CHAT_ID=
